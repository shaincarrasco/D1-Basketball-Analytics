# College Basketball Data API (CBBD) - obtain a key from the provider
CBBD_API_KEY=

# Optional persistence (Supabase/Postgres). Never expose service-role keys to client code.
DATABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Provider controls
DATA_MODE=demo
CBBD_BASE_URL=https://api.collegebasketballdata.com
